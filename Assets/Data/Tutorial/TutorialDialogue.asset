%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 855f8f4e7ed26844c9d4d37c8cdfeebc, type: 3}
  m_Name: TutorialDialogue
  m_EditorClassIdentifier: ProjectCR::ProjectCR.TutorialDialogueData
  dealerName: '**'
  intro:
  - text: "\uC544, \uC624\uC168\uAD70\uC694.\n\uBC18\uAC11\uC2B5\uB2C8\uB2E4. \uC774\uACF3\uC758
      \uB51C\uB7EC {dealer}\uC785\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 0
    camera: 1
  - text: "\uB9CE\uC774 \uB180\uB77C\uC168\uACA0\uC9C0\uC694.\n\uB208\uC744 \uD55C
      \uBC88 \uAE5C\uBE61\uC600\uC744 \uBFD0\uC778\uB370, \uB0AF\uC120 \uACF3\uC5D0
      \uC640 \uC788\uC73C\uB2C8 \uB9D0\uC785\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 0
    camera: 1
  - text: "\uC774\uACF3\uC740 \u2018\uC8FD\uC74C\uC758 \uBB38\uD131\u2019\uC785\uB2C8\uB2E4.\n\uB2F9\uC2E0\uC740
      \uC9C0\uAE08 \uC8FD\uC74C\uC744 \uC55E\uB450\uACE0 \uACC4\uC2ED\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 0
    camera: 1
  - text: "\uD558\uC9C0\uB9CC \uC544\uC9C1 \uAE30\uD68C\uB294 \uC788\uC2B5\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 0
    camera: 1
  - text: "\uC774 \uB8F0\uB81B\uC73C\uB85C \uC815\uD574\uC9C4 \uCD5C\uC885 \uAE08\uC561\uC744
      \uB9C8\uB828\uD558\uC2E0\uB2E4\uBA74,\n\uB2E4\uC2DC \uB3CC\uC544\uAC00\uC2E4
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 0
    camera: 1
  - text: "\uD639\uC2DC \uB8F0\uB81B \uADDC\uCE59\uC740 \uC54C\uACE0 \uACC4\uC2ED\uB2C8\uAE4C?"
    isQuestion: 1
    highlight: 0
    camera: 1
  knowsRules:
  - text: "\uC88B\uC2B5\uB2C8\uB2E4. \uADF8\uB7FC \uAE34 \uC124\uBA85\uC740 \uD544\uC694
      \uC5C6\uACA0\uAD70\uC694."
    isQuestion: 0
    highlight: 0
    camera: 1
  rouletteRules:
  - text: "\uD798\uB4E0 \uC5EC\uC815\uC774 \uB418\uC2DC\uACA0\uAD70\uC694.\n\uADF8\uB807\uB2E4\uBA74
      \uC81C\uAC00 \uAC04\uB2E8\uD788 \uC548\uB0B4\uD574 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 0
    camera: 2
  - text: "\uBA3C\uC800 \uD2B8\uB808\uC774\uC5D0\uC11C \uCE69\uC758 \uAE08\uC561\uC744
      \uACE0\uB974\uC2ED\uC2DC\uC624.\n\uADF8\uB9AC\uACE0 \uACF5\uC774 \uBA48\uCD9C
      \uAC83\uC73C\uB85C \uC608\uC0C1\uD558\uB294 \uACF3\uC5D0 \uCE69\uC744 \uB193\uC73C\uC2DC\uBA74
      \uB429\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 1
    camera: 0
  - text: "\uC22B\uC790 \uD558\uB098\uC5D0 \uAC78\uC5B4\uB3C4 \uC88B\uACE0,\n\uBE68\uAC15\uC774\uB098
      \uAC80\uC815, \uD640\uC218\uB098 \uC9DD\uC218\uCC98\uB7FC \uC5EC\uB7EC \uC22B\uC790\uC5D0
      \uAC78\uC5B4\uB3C4 \uC88B\uC2B5\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 2
    camera: 0
  - text: "\uC22B\uC790 \uC0AC\uC774\uC758 \uC120\uC774\uB098 \uAD50\uCC28\uC810\uC5D0\uB3C4
      \uBCA0\uD305\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC5B4\uB514\uC5D0 \uAC78\uB9AC\uB294\uC9C0
      \uD5F7\uAC08\uB9AC\uC2E0\uB2E4\uBA74, \uC7A0\uC2DC \uB9C8\uC6B0\uC2A4\uB97C
      \uC62C\uB824 \uBCF4\uC2ED\uC2DC\uC624.\n\uB300\uC0C1 \uC22B\uC790\uC640 \uC9C0\uAE09
      \uBC30\uC728\uC744 \uD655\uC778\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 3
    camera: 0
  - text: "\uB113\uAC8C \uAC78\uBA74 \uB9DE\uD790 \uAE30\uD68C\uAC00 \uB9CE\uC544\uC9D1\uB2C8\uB2E4.\n\uC22B\uC790
      \uD558\uB098\uB97C \uC815\uD655\uD788 \uB9DE\uD788\uBA74 \uB354 \uD070 \uAE08\uC561\uC744
      \uBC1B\uC73C\uC2E4 \uC218 \uC788\uC9C0\uC694."
    isQuestion: 0
    highlight: 0
    camera: 0
  - text: "\uD45C\uC2DC\uB41C \uBC30\uC728\uC740 \uC6D0\uAE08\uC744 \uD3EC\uD568\uD55C
      \uC9C0\uAE09\uC561\uC785\uB2C8\uB2E4.\n\uC608\uB97C \uB4E4\uC5B4 10\uC744 \uAC78\uC5B4
      2\uBC30\uB85C \uB2F9\uCCA8\uB418\uBA74, \uBC1B\uC73C\uC2DC\uB294 \uAE08\uC561\uC740
      20\uC785\uB2C8\uB2E4.\n\uB9DE\uD788\uC9C0 \uBABB\uD558\uBA74 \uAC78\uC5B4 \uB450\uC2E0
      \uB3C8\uC740 \uC783\uAC8C \uB429\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 4
    camera: 0
  - text: "\uC544, \uCD08\uB85D\uC0C9 0\uC740 \uC870\uAE08 \uB2E4\uB985\uB2C8\uB2E4.\n\uBE68\uAC15\uB3C4
      \uAC80\uC815\uB3C4 \uC544\uB2C8\uACE0, \uD640\uC218\uB098 \uC9DD\uC218\uC5D0\uB3C4
      \uD3EC\uD568\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n0\uC774 \uB098\uC624\uBA74
      0\uC5D0 \uC9C1\uC811 \uAC74 \uBCA0\uD305\uB9CC \uB2F9\uCCA8\uB429\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 5
    camera: 0
  commonRules:
  - text: "\uADF8\uB9AC\uACE0 \uBC18\uB4DC\uC2DC \uAE30\uC5B5\uD558\uC154\uC57C \uD560
      \uCE78\uC774 \uD558\uB098 \uC788\uC2B5\uB2C8\uB2E4.\n\uBCF4\uB77C\uC0C9\uC73C\uB85C
      \uD45C\uC2DC\uB41C \uC704\uD5D8 \uCE78\uC785\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 6
    camera: 3
  - text: "\uACF5\uC774 \uADF8\uACF3\uC5D0 \uB4E4\uC5B4\uAC00\uBA74, \uADF8 \uD68C\uC804\uC758
      \uBAA8\uB4E0 \uBCA0\uD305\uC740 \uB099\uCCA8\uB429\uB2C8\uB2E4.\n\uBCF4\uC720\uD558\uC2E0
      \uAE08\uC561\uB3C4 \uC808\uBC18\uC744 \uC783\uAC8C \uB418\uC9C0\uC694."
    isQuestion: 0
    highlight: 0
    camera: 0
  - text: "\uACF5\uC774 \uC5EC\uB7EC \uAC1C\uB77C \uD574\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uC785\uB2C8\uB2E4.\n\uB2E4\uB978
      \uACF5\uC774 \uB2F9\uCCA8\uB410\uB354\uB77C\uB3C4, \uBC29\uC5B4\uD558\uC9C0
      \uBABB\uD55C \uC704\uD5D8 \uCE78 \uD558\uB098\uAC00 \uBAA8\uB4E0 \uACB0\uACFC\uB97C
      \uC9C0\uC6CC \uBC84\uB9BD\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 0
    camera: 0
  - text: "\uAC00\uB2A5\uD558\uBA74 \uD53C\uD558\uC2DC\uB294 \uD3B8\uC774 \uC88B\uACA0\uC2B5\uB2C8\uB2E4.\n\uBB3C\uB860,
      \uB73B\uB300\uB85C \uB418\uC9C0\uB294 \uC54A\uACA0\uC9C0\uB9CC\uC694."
    isQuestion: 0
    highlight: 0
    camera: 0
  - text: "\uB77C\uC6B4\uB4DC\uB9C8\uB2E4 \uB3CC\uB9B4 \uC218 \uC788\uB294 \uD69F\uC218\uB294
      \uC815\uD574\uC838 \uC788\uC2B5\uB2C8\uB2E4.\n\uD68C\uC804\uC774 \uBAA8\uB450
      \uB05D\uB098\uBA74 \uD544\uC694\uD55C \uAE08\uC561\uC744 \uB0A9\uBD80\uD558\uC154\uC57C
      \uD569\uB2C8\uB2E4.\n\uB2F9\uCCA8\uB418\uC168\uB2E4\uACE0 \uD574\uC11C \uADF8
      \uB3C8\uC744 \uC804\uBD80 \uC368 \uBC84\uB9AC\uC9C0\uB294 \uB9C8\uC2ED\uC2DC\uC624."
    isQuestion: 0
    highlight: 0
    camera: 2
  - text: "\uC900\uBE44\uAC00 \uB418\uC168\uB2E4\uBA74 \u2018\uD68C\uC804\u2019\uC744
      \uB204\uB974\uC2ED\uC2DC\uC624.\n\uADF8 \uC21C\uAC04 \uBCA0\uD305\uAE08\uC774
      \uCC28\uAC10\uB418\uACE0, \uACF5\uC774 \uC6C0\uC9C1\uC774\uAE30 \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\uADF8
      \uB4A4\uC5D0\uB294 \uBCA0\uD305\uC744 \uBC14\uAFB8\uC2E4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 0
    camera: 0
  - text: "\uC124\uBA85\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uC785\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 0
    camera: 0
  - text: "\uADF8\uB7FC, \uD589\uC6B4\uC744 \uBE55\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 0
    camera: 0
  drink:
  - text: "\uBB34\uC0AC\uD788 \uD1B5\uACFC\uD558\uC168\uAD70\uC694!"
    isQuestion: 0
    highlight: 0
    camera: 0
  - text: "\uC800\uD76C \u2018\uC8FD\uC74C\uC758 \uBB38\uD131\u2019\uC774 \uC81C\uACF5\uD558\uB294
      \uCE75\uD14C\uC77C\uC744 \uC990\uACA8\uBCF4\uC2DC\uC8E0."
    isQuestion: 0
    highlight: 0
    camera: 0
  - text: "\uB3C8\uC744 \uBC8C \uB54C \uD070 \uB3C4\uC6C0\uC774 \uB420\uAC81\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 0
    camera: 0
  - text: "\uC774\uAC74 \uBB34\uB8CC\uC785\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 0
    camera: 0
  service:
  - text: "\uACE0\uAC1D\uB2D8. \uBCA0\uD305\uD558\uC2DC\uAE30 \uC804\uC5D0,\r\n\uC800\uD76C
      \u2018\uC8FD\uC74C\uC758 \uBB38\uD131\u2019\uC758 \uC11C\uBE44\uC2A4\uB97C
      \uD55C \uBC88 \uC774\uC6A9\uD574 \uBCF4\uC2DC\uACA0\uC5B4\uC694?"
    isQuestion: 0
    highlight: 0
    camera: 0
  - text: "\uACE0\uAC1D\uB2D8\uC5D0\uAC8C \uB3C4\uC6C0\uC774 \uB420 \uB9CC\uD55C
      \uBB3C\uD488\uC774 \uC788\uB2F5\uB2C8\uB2E4.\n\uB2E4\uB9CC, \uB3C8\uC740 \uB0B4\uC154\uC57C\uACA0\uC9C0\uB9CC\uC694."
    isQuestion: 0
    highlight: 0
    camera: 0
  startNotice: "\uD2B8\uB808\uC774\uC5D0\uC11C \uCE69\uC744 \uACE0\uB974\uACE0 \uD14C\uC774\uBE14
    \uBCA0\uD305\uD310\uC5D0 \uB193\uC740 \uB4A4 \u2018\uD68C\uC804\u2019\uC744 \uB204\uB974\uC2ED\uC2DC\uC624."
  gameOver:
  - text: "\uC548\uD0C0\uAE5D\uC2B5\uB2C8\uB2E4.\n\uC544\uC27D\uAC8C\uB3C4 \uC8FD\uC74C\uC758
      \uBB38\uD131\uC744 \uB118\uC9C0 \uBABB\uD558\uC168\uAD70\uC694."
    isQuestion: 0
    highlight: 0
    camera: 0
  - text: "\uB2F9\uC2E0\uC758 \uC0B6\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uC785\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 0
    camera: 0
  - text: "\uD589\uBCF5\uD55C \uC0B6\uC774\uC5C8\uAE30\uB97C\u2026"
    isQuestion: 0
    highlight: 0
    camera: 0
  gameClear:
  - text: "\uCD95\uD558\uD569\uB2C8\uB2E4!\n\uC8FD\uC74C\uC758 \uBB38\uD131\uC744
      \uB118\uC73C\uC168\uAD70\uC694!"
    isQuestion: 0
    highlight: 0
    camera: 0
  - text: "\uB2F9\uC2E0\uC5D0\uAC8C \uB2E4\uC2DC \uD55C\uBC88 \uC0B6\uC758 \uAE30\uD68C\uB97C
      \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    isQuestion: 0
    highlight: 0
    camera: 0
  - text: "\uC88B\uC740 \uB9C8\uBB34\uB9AC\uB97C \uD558\uACE0 \uC624\uC2DC\uAE38\u2026"
    isQuestion: 0
    highlight: 0
    camera: 0
