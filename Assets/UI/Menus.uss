/* 메인 메뉴·옵션·일시정지·결과 공용 스타일: 검은 바탕, 황동 테두리, 아이보리 글자.
   버튼은 같은 너비·높이의 가로형 버튼을 위에서 아래로 쌓는다(일정한 간격). 옵션 탭만 가로로 나란히. */

:root {
    --menu-bg: rgb(6, 6, 7);
    --menu-control: rgb(22, 22, 24);
    --menu-control-hover: rgb(40, 38, 34);
    --menu-brass: rgb(200, 156, 72);
    --menu-brass-light: rgb(236, 196, 112);
    --menu-ivory: rgb(244, 236, 216);
    --menu-muted: rgb(170, 182, 166);
}

.menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 템플릿 인스턴스(옵션창)가 화면 전체를 덮을 수 있게. 숨겨져 있으면 입력을 받지 않는다. */
.menu-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 뒤쪽 화면·3D 테이블 클릭을 막는 어두운 바탕 + 가운데 창. */
.menu-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    /* 리니어 색 공간에서는 어두운 반투명이 눈에 덜 어둡게 보여서 0.78로 진하게. */
    background-color: rgba(0, 0, 0, 0.78);
    display: none;
}

.menu-panel {
    min-width: 360px;
    max-width: 92%;
    max-height: 92%;
    padding: 28px 40px 32px 40px;
    align-items: center;
    background-color: var(--menu-bg);
    border-width: 2px;
    border-color: var(--menu-brass);
    border-radius: 12px;
}

.menu-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--menu-ivory);
    margin-bottom: 22px;
    -unity-text-align: middle-center;
}

.menu-buttons {
    align-items: stretch;
}

/* 가로형 버튼 하나. 모든 메뉴 버튼이 같은 크기. */
.menu-button {
    width: 300px;
    max-width: 100%;
    height: 54px;
    margin: 0 0 12px 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--menu-ivory);
    background-color: var(--menu-control);
    border-width: 2px;
    border-color: var(--menu-brass);
    border-radius: 8px;
}

.menu-button:hover {
    background-color: var(--menu-control-hover);
    border-color: var(--menu-brass-light);
}

.menu-button:active {
    background-color: rgb(12, 12, 13);
}

.menu-button:disabled {
    opacity: 0.45;
}

.menu-close {
    width: 40px;
    height: 40px;
    font-size: 20px;
    color: var(--menu-ivory);
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: var(--menu-brass);
    border-radius: 8px;
}

.menu-close:hover {
    background-color: var(--menu-control-hover);
}

/* ---------- 메인 메뉴 ---------- */

.main-menu-root {
    background-color: rgb(0, 0, 0);
    align-items: center;
    justify-content: center;
}

.main-menu {
    align-items: center;
}

.main-title {
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--menu-ivory);
    margin-bottom: 48px;
    -unity-text-align: middle-center;
}

/* ---------- 옵션창 ---------- */

.options-box {
    width: 680px;
    align-items: stretch;
}

.options-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.options-title {
    margin-bottom: 0;
    -unity-text-align: middle-left;
}

.options-tabs {
    flex-direction: row;
    margin-bottom: 20px;
}

.options-tab {
    flex-grow: 1;
    flex-basis: 0;
    height: 46px;
    margin: 0 4px;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--menu-muted);
    background-color: var(--menu-control);
    border-width: 2px;
    border-color: rgba(200, 156, 72, 0.45);
    border-radius: 8px;
}

.options-tab--active {
    color: rgb(28, 22, 12);
    background-color: var(--menu-brass);
    border-color: var(--menu-brass-light);
}

.options-page {
    min-height: 220px;
}

.options-row {
    flex-direction: row;
    align-items: center;
    min-height: 52px;
    margin-bottom: 8px;
}

.options-label {
    width: 150px;
    flex-shrink: 0;
    font-size: 19px;
    color: var(--menu-ivory);
}

.options-slider {
    flex-grow: 1;
    margin: 0 12px 0 0;
}

.options-value {
    width: 64px;
    flex-shrink: 0;
    font-size: 19px;
    color: var(--menu-brass-light);
    -unity-text-align: middle-right;
}

.options-dropdown {
    flex-grow: 1;
    margin: 0;
    font-size: 18px;
}

/* 드롭다운 칸: 기본 회색 대신 메뉴 색. */
.options-dropdown .unity-base-popup-field__input,
.options-dropdown .unity-popup-field__input {
    min-height: 38px;
    padding: 0 12px;
    color: var(--menu-ivory);
    background-color: var(--menu-control);
    border-width: 2px;
    border-color: rgba(200, 156, 72, 0.7);
    border-radius: 6px;
}

.options-dropdown .unity-base-popup-field__input:hover {
    border-color: var(--menu-brass-light);
}

.options-dropdown .unity-base-popup-field__text {
    color: var(--menu-ivory);
}

.options-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--menu-brass-light);
}

/* 슬라이더: 황동 막대와 손잡이. */
.options-slider .unity-base-slider__tracker {
    height: 6px;
    margin-top: -3px;
    background-color: rgb(48, 44, 38);
    border-width: 1px;
    border-color: rgba(200, 156, 72, 0.6);
    border-radius: 3px;
}

.options-slider .unity-base-slider__dragger {
    width: 18px;
    height: 22px;
    margin-top: -11px;
    background-color: var(--menu-brass);
    border-width: 1px;
    border-color: var(--menu-brass-light);
    border-radius: 4px;
}

/* ---------- 결과 ---------- */

.result-box {
    min-width: 520px;
}

.result-title {
    font-size: 44px;
    color: rgb(226, 120, 104);
}

.result-title--clear {
    color: var(--menu-brass-light);
}

.result-text {
    font-size: 21px;
    color: var(--menu-ivory);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 26px;
    max-width: 640px;
}
