/* 룰렛 HUD. 기준 해상도 1920x1080 (PanelSettings: Scale With Screen Size).
   화면 대부분은 3D 테이블이다. 위에 상태 바와 결과, 아래에 베팅 요약·회전 띠만 둔다.
   3D 입력을 막아야 하는 요소에는 blocks-input 클래스를 붙인다(RouletteHud.IsPointerOverUi). */

:root {
    --ink: rgba(12, 14, 20, 0.86);
    --line: rgba(255, 255, 255, 0.12);
    --text: rgb(236, 232, 222);
    --muted: rgb(170, 166, 156);
    --gold: rgb(255, 209, 64);
}

.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--text);
    font-size: 20px;
}

/* ---------- 상태 바 ---------- */

.topbar {
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding-left: 24px;
    padding-right: 16px;
    background-color: var(--ink);
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.stat {
    margin-right: 32px;
    font-size: 22px;
    -unity-font-style: bold;
}

.stat--money {
    color: var(--gold);
}

.spacer {
    flex-grow: 1;
}

.seed {
    margin-right: 16px;
    font-size: 14px;
    color: var(--muted);
}

/* ---------- 결과 (상태 바 아래 왼쪽) ---------- */

.result-panel {
    position: absolute;
    left: 24px;
    top: 68px;
    max-width: 1100px;
    padding: 10px 16px;
    background-color: var(--ink);
    border-radius: 8px;
}

.result {
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

.result--skull {
    color: rgb(255, 120, 110);
}

.history {
    margin-top: 4px;
    font-size: 15px;
    color: var(--muted);
}

/* ---------- 베팅 요약·회전 (화면 아래 띠) ---------- */

.control-panel {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 16px;
    flex-direction: row;
    align-items: center;
    padding: 10px 16px;
    background-color: var(--ink);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--line);
}

.info {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 16px;
}

.row {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
}

.field-label {
    width: 52px;
    color: var(--muted);
}

.field-value {
    margin-right: 16px;
    font-size: 18px;
    -unity-font-style: bold;
}

.chip-value {
    min-width: 80px;
    margin-right: 16px;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--gold);
}

.hover-target {
    flex-grow: 1;
    font-size: 15px;
    color: var(--muted);
}

.skull-notice {
    font-size: 15px;
    color: rgb(232, 224, 200);
}

.bet-list {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 15px;
    color: var(--muted);
    overflow: hidden;
}

.preview {
    margin-right: 16px;
    font-size: 15px;
    color: var(--gold);
}

.error {
    font-size: 15px;
    color: rgb(255, 120, 110);
}

.button-row {
    flex-direction: row;
    align-items: center;
    width: 600px;
}

/* ---------- 버튼 ---------- */

.btn {
    margin: 2px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
    background-color: rgb(46, 50, 62);
    color: var(--text);
}

.btn:hover {
    background-color: rgb(64, 70, 86);
}

.btn--small {
    height: 36px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 16px;
}

.btn--wide {
    width: 150px;
    height: 64px;
    font-size: 16px;
}

.btn--primary {
    flex-grow: 1;
    height: 64px;
    background-color: rgb(196, 150, 40);
    color: rgb(20, 18, 12);
    font-size: 24px;
    -unity-font-style: bold;
}

.btn--primary:hover {
    background-color: rgb(230, 182, 60);
}

.btn--modal {
    flex-grow: 0;
    height: 64px;
    margin-top: 8px;
}

.btn:disabled {
    opacity: 0.4;
}

/* ---------- 납부 / 게임 오버 ---------- */

.modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
    display: none;
}

.modal__box {
    width: 640px;
    padding: 32px;
    background-color: rgb(27, 30, 38);
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--gold);
}

.modal__text {
    margin-bottom: 16px;
    font-size: 24px;
    white-space: normal;
}
