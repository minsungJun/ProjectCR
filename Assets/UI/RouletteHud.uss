/* 룰렛 HUD. 기준 해상도 1920x1080 (PanelSettings: Scale With Screen Size).
   화면 대부분은 3D 테이블이다. 위에 상태 바와 결과, 아래에 베팅 요약·회전 띠만 둔다.
   3D 입력을 막아야 하는 요소에는 blocks-input 클래스를 붙인다(RouletteHud.IsPointerOverUi). */

:root {
    --ink: rgba(12, 14, 20, 0.86);
    --line: rgba(255, 255, 255, 0.12);
    --text: rgb(236, 232, 222);
    --muted: rgb(170, 166, 156);
    --gold: rgb(255, 209, 64);
}

.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--text);
    font-size: 20px;
}

/* ---------- 옵션 (오른쪽 위) ---------- */

.options {
    position: absolute;
    top: 12px;
    right: 16px;
    align-items: flex-end;
}

.options-row {
    flex-direction: row;
}

.view-toggle {
    min-width: 88px;
    margin-right: 8px;
}

.options-button {
    min-width: 88px;
}

.spacer {
    flex-grow: 1;
}

/* ---------- 딜러 튜토리얼 대화창 (왼쪽 위) ---------- */

/* 검은 바탕, 황동 테두리, 아이보리 글자. 결과 안내 자리에 뜨고, 그동안 결과 안내는 숨긴다(RouletteHud.SetResultVisible). */
.tutorial-panel {
    position: absolute;
    left: 24px;
    top: 16px;
    width: 860px;
    max-width: 72%;
    min-width: 300px;
    flex-direction: row;
    align-items: flex-start;
    padding: 14px 18px 14px 14px;
    background-color: rgba(6, 6, 7, 0.94);
    border-width: 2px;
    border-color: rgb(200, 156, 72);
    border-radius: 10px;
    display: none;
    opacity: 0;
    translate: 0 -8px;
    transition-property: opacity, translate;
    transition-duration: 0.18s, 0.18s;
}

.tutorial-panel--open {
    opacity: 1;
    translate: 0 0;
}

.tutorial-dealer-icon {
    width: 92px;
    height: 92px;
    flex-shrink: 0;
    margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.tutorial-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.tutorial-speaker {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(214, 170, 86);
    margin-bottom: 4px;
}

.tutorial-text {
    min-height: 66px;
    font-size: 21px;
    color: rgb(244, 236, 216);
    white-space: normal;
}

.tutorial-choice-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
    display: none;
}

.tutorial-button {
    min-width: 96px;
    height: 36px;
    margin: 0 0 0 8px;
    padding: 0 16px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(28, 22, 12);
    background-color: rgb(214, 170, 86);
    border-width: 1px;
    border-color: rgb(244, 220, 160);
    border-radius: 6px;
}

.tutorial-button:hover {
    background-color: rgb(236, 192, 104);
}

.tutorial-button:disabled {
    opacity: 0.5;
}

.tutorial-next {
    align-self: flex-end;
    margin-top: 10px;
    display: none;
}

/* ---------- 결과 (왼쪽 위) ---------- */

.result-area {
    position: absolute;
    left: 24px;
    top: 16px;
    max-width: 1100px;
    align-items: flex-start;
}

.result-panel {
    padding: 10px 16px;
    flex-direction: row;
    align-items: center;
    background-color: var(--ink);
    border-radius: 8px;
}

/* 결과 숫자: 칸 색(빨강·검정·초록, 해골은 보라) 배경의 작은 패. 회전 결과일 때만 보인다. */
.result-balls {
    flex-direction: row;
    flex-shrink: 0;
    margin-right: 6px;
    display: none;
}

.result-ball {
    min-width: 40px;
    height: 40px;
    margin-right: 6px;
    padding: 0 6px 0 6px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(250, 246, 236);
    border-width: 2px;
    border-color: rgba(240, 220, 170, 0.75);
    border-radius: 6px;
}

/* 이전에 나온 숫자(최근 것이 왼쪽). 결과 패보다 작게. */
.result-history {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding: 6px 12px;
    background-color: var(--ink);
    border-radius: 8px;
    display: none;
}

/* 딜러의 귀띔: 다음 회전에 나오지 않는 베팅. 상점을 나간 뒤 첫 회전 전까지만 보인다. */
.dealer-hint {
    margin-top: 6px;
    padding: 6px 12px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(240, 192, 80);
    background-color: var(--ink);
    border-width: 1px;
    border-color: rgb(200, 156, 72);
    border-radius: 8px;
    display: none;
}

.result-history__label {
    margin-right: 8px;
    font-size: 15px;
    color: var(--muted);
}

.result-ball--small {
    min-width: 28px;
    height: 28px;
    margin-right: 4px;
    padding: 0 4px 0 4px;
    font-size: 15px;
    border-width: 1px;
    border-radius: 5px;
}

.result-ball--red {
    background-color: rgb(176, 34, 40);
}

.result-ball--black {
    background-color: rgb(22, 22, 26);
}

.result-ball--green {
    background-color: rgb(20, 110, 62);
}

.result-ball--skull {
    background-color: rgb(115, 81, 152);
}

.result {
    flex-shrink: 1;
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

.result--skull {
    color: rgb(255, 120, 110);
}

.result--gain {
    color: rgb(240, 192, 80);
}

.result-separator {
    margin-left: 4px;
    font-size: 24px;
    color: var(--muted);
    -unity-text-align: middle-left;
}

.result-prefix {
    margin-right: 10px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

/* ---------- 버튼 ---------- */

.btn {
    margin: 2px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
    background-color: rgb(46, 50, 62);
    color: var(--text);
}

.btn:hover {
    background-color: rgb(64, 70, 86);
}

.btn--small {
    height: 36px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 16px;
}

.btn--primary {
    flex-grow: 1;
    height: 64px;
    background-color: rgb(196, 150, 40);
    color: rgb(20, 18, 12);
    font-size: 24px;
    -unity-font-style: bold;
}

.btn--primary:hover {
    background-color: rgb(230, 182, 60);
}

.btn--modal {
    flex-grow: 0;
    height: 64px;
    margin-top: 8px;
}

.btn:disabled {
    opacity: 0.4;
}

/* ---------- 납부 / 게임 오버 ---------- */

.modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
    display: none;
}

.modal__box {
    width: 640px;
    padding: 32px;
    background-color: rgb(27, 30, 38);
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--gold);
}

.modal__text {
    margin-bottom: 16px;
    font-size: 24px;
    white-space: normal;
}

/* ---------- 태블릿 "마신 음료" 화면 ----------
   태블릿 화면 메시 자리에 TabletDrinkEffectsView가 맞춰 놓는다(위치·크기는 코드). 화면 색 바탕, 아이보리 글자, 효과 수치는 금색,
   행 사이 얇은 황동 선. 카메라가 오가는 동안은 숨긴다. */
.tablet-drinks {
    position: absolute;
    padding: 18px 22px 14px 26px;
    background-color: rgb(16, 52, 37);
    border-radius: 22px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.tablet-drinks--hidden {
    opacity: 0;
}

.tablet-drinks__header {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    padding-bottom: 8px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(198, 154, 78);
}

.tablet-drinks__title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(244, 234, 210);
}

.tablet-drinks__subtitle {
    margin-top: 2px;
    font-size: 17px;
    color: rgb(190, 200, 180);
}

.tablet-drinks__close {
    width: 48px;
    height: 48px;
    margin: 0;
    padding: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 240, 230);
    background-color: rgb(178, 44, 38);
    border-width: 2px;
    border-color: rgb(110, 22, 18);
    border-radius: 8px;
}

.tablet-drinks__close:hover {
    background-color: rgb(212, 60, 50);
}

.tablet-drinks__list {
    flex-grow: 1;
    margin-top: 6px;
}

.tablet-drinks__row {
    flex-direction: row;
    align-items: center;
    padding: 7px 8px 7px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(198, 154, 78, 0.55);
}

.tablet-drinks__row--last {
    border-bottom-width: 0;
}

.tablet-drinks__text {
    flex-grow: 1;
    margin-left: 14px;
}

.tablet-drinks__name {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(244, 236, 214);
}

.tablet-drinks__effect {
    margin-top: 1px;
    font-size: 19px;
    color: rgb(240, 196, 84);
}

.tablet-drinks__stacks {
    min-width: 60px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(244, 236, 214);
    -unity-text-align: middle-right;
}

.tablet-drinks__empty {
    margin-top: 18px;
    font-size: 22px;
    color: rgb(190, 200, 180);
}

/* 잔 그림: 위가 넓은 역삼각형(테두리 삼각형) + 다리 + 받침. */
.tablet-drinks__glass {
    width: 34px;
    align-items: center;
}

.tablet-drinks__glass-bowl {
    width: 0;
    height: 0;
    border-left-width: 15px;
    border-right-width: 15px;
    border-top-width: 16px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
}

.tablet-drinks__glass-stem {
    width: 3px;
    height: 12px;
    background-color: rgb(214, 206, 186);
}

.tablet-drinks__glass-foot {
    width: 18px;
    height: 3px;
    border-radius: 2px;
    background-color: rgb(214, 206, 186);
}

.tablet-drinks__list .unity-scroller--vertical {
    width: 8px;
    margin-left: 6px;
}

.tablet-drinks__list .unity-scroller__low-button,
.tablet-drinks__list .unity-scroller__high-button {
    display: none;
}

.tablet-drinks__list .unity-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 0;
    border-radius: 4px;
}

.tablet-drinks__list .unity-scroller .unity-base-slider__dragger {
    left: 0;
    right: 0;
    width: 8px;
    background-color: rgb(200, 156, 72);
    border-width: 0;
    border-radius: 4px;
}

/* 태블릿 화면에 맞춰 띄울 때: 어두운 배경 없이, 창은 ShopView가 화면 메시 사각형에 놓는다.
   창 둘레는 태블릿 베젤이 대신하니 나무 틀을 빼고 화면 색에 맞춘다. 카메라가 오는 동안은 숨긴다. */
.shop-modal--tablet {
    background-color: rgba(0, 0, 0, 0);
}

.shop-modal--tablet .shop-box {
    position: absolute;
    max-width: none;
    padding: 18px 26px 22px 26px;
    background-color: rgb(20, 46, 34);
    border-width: 0;
    border-radius: 36px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.shop-modal--tablet-hidden .shop-box {
    opacity: 0;
}

.shop-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-left: 6px;
}

.shop-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(244, 234, 210);
}

.shop-wallet {
    flex-direction: row;
    align-items: center;
    margin-right: 18px;
}

.shop-wallet__label {
    margin-left: 10px;
    font-size: 24px;
    color: rgb(226, 218, 196);
}

.shop-money {
    margin-left: 8px;
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(240, 192, 80);
}

/* 코인 아이콘 자리. 스프라이트가 없으면 금색 원으로 그린다(ShopView가 배경 이미지를 넣으면 색·테두리를 끈다). */
.shop-coin {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(150, 104, 30);
    background-color: rgb(240, 192, 80);
    -unity-background-scale-mode: scale-to-fit;
}

.shop-coin--large {
    width: 38px;
    height: 38px;
    border-radius: 19px;
    border-width: 3px;
}

.shop-coin--sprite {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.shop-close {
    width: 56px;
    height: 56px;
    margin: 0;
    padding: 0;
    font-size: 30px;
    -unity-font-style: bold;
    flex-shrink: 0;
    color: rgb(255, 240, 230);
    background-color: rgb(178, 44, 38);
    border-width: 2px;
    border-color: rgb(110, 22, 18);
    border-radius: 6px;
}

.shop-close:hover {
    background-color: rgb(212, 60, 50);
}

.shop-funds {
    align-self: flex-end;
    margin-right: 80px;
    font-size: 16px;
    color: rgb(200, 186, 150);
}

.shop-tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 8px;
    margin-bottom: 12px;
}

.shop-tab {
    flex-grow: 1;
    flex-basis: 0;
    height: 56px;
    margin: 0 4px 0 4px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(226, 206, 160);
    background-color: rgb(40, 26, 15);
    border-width: 2px;
    border-color: rgb(150, 116, 58);
    border-radius: 6px;
}

.shop-tab:hover {
    background-color: rgb(62, 40, 24);
}

.shop-tab--active {
    color: rgb(40, 24, 8);
    background-color: rgb(232, 184, 74);
    border-color: rgb(255, 222, 150);
    border-bottom-width: 5px;
    border-bottom-color: rgb(255, 214, 110);
}

.shop-tab--active:hover {
    background-color: rgb(244, 198, 92);
}

.shop-felt {
    flex-grow: 1;
    padding: 18px 14px 10px 14px;
    background-color: rgb(16, 56, 38);
    border-width: 3px;
    border-color: rgb(120, 86, 40);
    border-radius: 8px;
}

.shop-notice {
    margin: 0 8px 10px 8px;
    font-size: 18px;
    color: rgb(255, 214, 120);
    white-space: normal;
}

.shop-scroll {
    flex-grow: 1;
}

.shop-cards {
    flex-direction: row;
    flex-wrap: wrap;
}

/* 한 줄 4장: 폭 23% + 좌우 여백 1%씩. */
.shop-card {
    width: 23%;
    margin: 0 1% 18px 1%;
    padding: 18px 16px 16px 16px;
    align-items: center;
    background-color: rgb(14, 44, 30);
    border-width: 2px;
    border-color: rgb(200, 156, 72);
    border-radius: 8px;
}

.shop-card--done {
    opacity: 0.6;
}

.shop-discard-cancel {
    align-self: center;
    min-width: 160px;
    margin-top: 4px;
    margin-bottom: 12px;
}

.shop-icon {
    width: 132px;
    height: 132px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

.shop-icon--placeholder {
    width: 112px;
    height: 112px;
    margin-top: 10px;
    margin-bottom: 20px;
    border-radius: 56px;
    border-width: 3px;
    border-color: rgba(255, 236, 190, 0.7);
}

.shop-icon__label {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(252, 244, 222);
}

.shop-name {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(246, 238, 218);
    -unity-text-align: middle-center;
    white-space: normal;
}

.shop-dash {
    width: 34px;
    height: 3px;
    margin: 10px 0 10px 0;
    background-color: rgb(232, 184, 74);
}

.shop-desc {
    min-height: 52px;
    font-size: 18px;
    color: rgb(222, 222, 206);
    -unity-text-align: middle-center;
    white-space: normal;
}

.shop-state {
    margin-top: 6px;
    font-size: 14px;
    color: rgb(170, 190, 168);
    -unity-text-align: middle-center;
    white-space: normal;
}

.shop-targets {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
}

.shop-target {
    height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    margin: 2px;
    font-size: 15px;
    color: rgb(226, 218, 196);
    background-color: rgb(10, 34, 23);
    border-width: 1px;
    border-color: rgb(150, 116, 58);
    border-radius: 6px;
}

.shop-target:hover {
    background-color: rgb(24, 60, 42);
}

.shop-target--selected {
    background-color: rgb(232, 184, 74);
    color: rgb(40, 24, 8);
    -unity-font-style: bold;
}

.shop-sep {
    align-self: stretch;
    height: 1px;
    margin-top: auto;
    margin-bottom: 12px;
    background-color: rgba(200, 156, 72, 0.45);
}

/* 구분선 위쪽 내용과 구분선 사이 최소 간격(구분선의 margin-top: auto가 카드 높이 차를 흡수한다). */
.shop-card__body {
    align-self: stretch;
    align-items: center;
    margin-bottom: 14px;
}

.shop-price-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.shop-price {
    margin-left: 8px;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(240, 192, 80);
}

.shop-buy {
    align-self: stretch;
    height: 50px;
    margin: 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(40, 24, 8);
    background-color: rgb(232, 184, 74);
    border-width: 2px;
    border-color: rgb(255, 222, 150);
    border-radius: 6px;
}

.shop-buy:hover {
    background-color: rgb(248, 204, 100);
}

.shop-buy:disabled {
    color: rgb(200, 186, 150);
    background-color: rgb(60, 52, 36);
    border-color: rgb(110, 92, 56);
    opacity: 1;
}

.shop-reason {
    margin-top: 6px;
    font-size: 14px;
    color: rgb(255, 160, 130);
    -unity-text-align: middle-center;
    white-space: normal;
}

.shop-section {
    margin: 6px 1% 6px 1%;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(232, 184, 74);
}

.shop-summary {
    margin: 0 1% 8px 1%;
    font-size: 16px;
    color: rgb(222, 222, 206);
    white-space: normal;
}

.shop-empty {
    margin: 30px 1% 30px 1%;
    font-size: 20px;
    color: rgb(200, 210, 190);
    -unity-text-align: middle-center;
}

/* 카드가 넘칠 때의 세로 스크롤바: 기본 흰 막대 대신 펠트 위의 얇은 금색 막대. */
.shop-scroll .unity-scroller--vertical {
    width: 10px;
    margin-left: 6px;
}

.shop-scroll .unity-scroller__low-button,
.shop-scroll .unity-scroller__high-button {
    display: none;
}

.shop-scroll .unity-scroller--vertical > .unity-scroller__slider {
    margin: 0;
}

.shop-scroll .unity-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 0;
    border-radius: 5px;
}

.shop-scroll .unity-scroller .unity-base-slider__dragger {
    left: 0;
    right: 0;
    width: 10px;
    background-color: rgb(200, 156, 72);
    border-width: 0;
    border-radius: 5px;
}

/* ---------- 판 위 호버 안내 ----------
   커서 위쪽에 뜨는 작은 툴팁. 짙은 녹색 + 황동 테두리 + 아이보리 글자, 강화된 최종 배율만 금색으로 강조.
   위치는 RouletteHud.MoveBetTooltip이 매 프레임 left/top으로 잡는다(화면 가장자리에서 안으로 밀고, 위가 모자라면 커서 아래로). */

.bet-tooltip {
    position: absolute;
    left: 0;
    top: 0;
    padding: 8px 14px 9px 14px;
    background-color: rgba(12, 44, 30, 0.94);
    border-width: 2px;
    border-color: rgb(200, 156, 72);
    border-radius: 7px;
    display: none;
}

.bet-tooltip__head {
    flex-direction: row;
    align-items: center;
}

.bet-tooltip__kind {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(244, 236, 216);
}

.bet-tooltip__base {
    margin-left: 8px;
    font-size: 16px;
    color: rgb(170, 186, 168);
}

.bet-tooltip__final {
    margin-left: 6px;
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(244, 236, 216);
}

.bet-tooltip__final--boosted {
    color: rgb(240, 192, 80);
}

.bet-tooltip__targets {
    margin-top: 2px;
    font-size: 17px;
    color: rgb(236, 228, 206);
}

.bet-tooltip__stake {
    margin-top: 3px;
    font-size: 15px;
    color: rgb(200, 210, 186);
}

.bet-tooltip__progress {
    margin-top: 3px;
    font-size: 15px;
    color: rgb(240, 192, 80);
}

.bet-tooltip--wrap .bet-tooltip__targets,
.bet-tooltip--wrap .bet-tooltip__stake {
    max-width: 440px;
    white-space: normal;
}

.bet-tooltip__note {
    margin-top: 3px;
    font-size: 14px;
    color: rgb(160, 172, 156);
    display: none;
}

.bet-tooltip--wrap .bet-tooltip__note {
    max-width: 440px;
    white-space: normal;
}

.bet-tooltip__stake--short {
    color: rgb(150, 150, 136);
}
