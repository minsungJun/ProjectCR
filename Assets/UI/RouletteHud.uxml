<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="RouletteHud.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <!-- 오른쪽 위 옵션: 누르면 작은 메뉴(시점 전환)가 열린다. -->
        <ui:VisualElement class="options blocks-input">
            <ui:Button name="options" class="btn btn--small options-button" text="옵션" />
            <ui:VisualElement name="options-menu" class="options-menu">
                <ui:Button name="view-toggle" class="btn btn--small options-item" text="시점 전환" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 회전 결과(나온 숫자 · 손익)와 그 아래 이전에 나온 숫자 5개. 게임 시작 때만 안내 문구. -->
        <ui:VisualElement class="result-area" picking-mode="Ignore">
            <ui:VisualElement class="result-panel" picking-mode="Ignore">
                <ui:VisualElement name="result-balls" class="result-balls" picking-mode="Ignore" />
                <ui:Label name="result" class="result" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="result-history" class="result-history" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- 라운드 통과 보상. 카드는 DrinkSelectionView가 후보 수만큼 만든다. -->
        <ui:VisualElement name="drink-panel" class="modal drink-modal blocks-input">
            <ui:VisualElement class="drink-box">
                <ui:Label name="drink-header" class="drink-header" />
                <ui:Label class="drink-title" text="음료 하나를 선택하세요" />
                <ui:VisualElement name="drink-cards" class="drink-cards" />
                <ui:Label name="drink-hint" class="drink-hint" text="카드를 눌러 고른 뒤 확정하세요. 효과는 이번 게임 끝까지 이어집니다. 지급 음료는 곱해서, 확률 음료는 더해서 쌓이고, 해골 확률(1/38)은 바뀌지 않습니다." />
                <ui:Button name="drink-confirm" class="btn drink-confirm" text="선택 확정" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 서비스(상점). [소모품] / [강화] 탭, 상품 카드는 ShopView가 그린다. 코인 아이콘은 ShopCatalog.moneyIcon. -->
        <ui:VisualElement name="shop-panel" class="modal shop-modal blocks-input">
            <ui:VisualElement class="shop-box">
                <ui:VisualElement class="shop-header">
                    <ui:Label class="shop-title" text="서비스" />
                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                    <ui:VisualElement class="shop-wallet" picking-mode="Ignore">
                        <ui:VisualElement name="shop-coin" class="shop-coin shop-coin--large" picking-mode="Ignore" />
                        <ui:Label class="shop-wallet__label" text="보유" />
                        <ui:Label name="shop-money" class="shop-money" text="0" />
                    </ui:VisualElement>
                    <ui:Button name="shop-close" class="shop-close" text="✕" />
                </ui:VisualElement>
                <ui:Label name="shop-funds" class="shop-funds" />
                <ui:VisualElement class="shop-tabs">
                    <ui:Button name="shop-tab-consumable" class="shop-tab" text="소모품" />
                    <ui:Button name="shop-tab-upgrade" class="shop-tab" text="강화" />
                </ui:VisualElement>
                <ui:VisualElement class="shop-felt">
                    <ui:Label name="shop-notice" class="shop-notice" />
                    <ui:ScrollView name="shop-scroll" class="shop-scroll" mode="Vertical" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 판 위 호버 안내. 커서를 따라다니고 입력을 받지 않는다(blocks-input 없음, picking Ignore). 내용은 RouletteHud.ShowBetTooltip. -->
        <ui:VisualElement name="bet-tooltip" class="bet-tooltip" picking-mode="Ignore">
            <ui:VisualElement class="bet-tooltip__head" picking-mode="Ignore">
                <ui:Label name="bet-tooltip-kind" class="bet-tooltip__kind" picking-mode="Ignore" />
                <ui:Label name="bet-tooltip-base" class="bet-tooltip__base" picking-mode="Ignore" />
                <ui:Label name="bet-tooltip-final" class="bet-tooltip__final" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="bet-tooltip-targets" class="bet-tooltip__targets" picking-mode="Ignore" />
            <ui:Label name="bet-tooltip-stake" class="bet-tooltip__stake" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="gameover-panel" class="modal blocks-input">
            <ui:VisualElement class="modal__box">
                <ui:Label name="gameover-text" class="modal__text" />
                <ui:Button name="restart" class="btn btn--primary btn--modal" text="다시 시작" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
