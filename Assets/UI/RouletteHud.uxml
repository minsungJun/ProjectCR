<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="RouletteHud.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <ui:VisualElement class="topbar">
            <ui:Label name="round" class="stat" text="라운드 1" />
            <ui:Label name="spins" class="stat" text="남은 회전" />
            <ui:Label name="due" class="stat" text="납부금" />
            <ui:Label name="money" class="stat stat--money" text="보유" />
            <ui:VisualElement class="spacer" picking-mode="Ignore" />
            <ui:Label name="seed" class="seed" text="seed" />
            <ui:Button name="view-toggle" class="btn btn--small" text="시점 전환" />
        </ui:VisualElement>

        <ui:VisualElement class="bet-panel">
            <ui:Label class="panel-title" text="베팅 선택 (회전당 하나) · 칸 사이 점 = 안쪽 베팅" />
            <ui:VisualElement name="number-grid" class="number-grid" />
            <ui:Label name="skull-notice" class="skull-notice" text="해골: 이번 회전의 모든 베팅 낙첨" />

            <ui:VisualElement class="row">
                <ui:Label class="field-label" text="베팅 대상" />
                <ui:Label name="selected" class="field-value" text="—" />
            </ui:VisualElement>
            <ui:VisualElement class="row">
                <ui:Label class="field-label" text="베팅 금액" />
                <ui:Label name="stake" class="field-value" text="0" />
            </ui:VisualElement>
            <ui:VisualElement class="stake-buttons">
                <ui:Button name="stake-minus10" class="btn btn--stake" text="-10" />
                <ui:Button name="stake-minus1" class="btn btn--stake" text="-1" />
                <ui:Button name="stake-plus1" class="btn btn--stake" text="+1" />
                <ui:Button name="stake-plus10" class="btn btn--stake" text="+10" />
                <ui:Button name="stake-half" class="btn btn--stake" text="½" />
                <ui:Button name="stake-double" class="btn btn--stake" text="×2" />
                <ui:Button name="stake-max" class="btn btn--stake" text="최대" />
            </ui:VisualElement>

            <ui:Label name="payout-preview" class="preview" />
            <ui:Label name="bet-error" class="error" />
            <ui:Button name="spin" class="btn btn--primary" text="회전" />
        </ui:VisualElement>

        <ui:VisualElement class="result-panel" picking-mode="Ignore">
            <ui:Label name="result" class="result" />
            <ui:Label name="history" class="history" />
        </ui:VisualElement>

        <ui:VisualElement name="payment-panel" class="modal">
            <ui:VisualElement class="modal__box">
                <ui:Label name="payment-text" class="modal__text" />
                <ui:Button name="pay" class="btn btn--primary" text="납부" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="gameover-panel" class="modal">
            <ui:VisualElement class="modal__box">
                <ui:Label name="gameover-text" class="modal__text" />
                <ui:Button name="restart" class="btn btn--primary" text="다시 시작" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
