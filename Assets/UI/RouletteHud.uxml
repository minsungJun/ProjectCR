<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="RouletteHud.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <ui:VisualElement class="topbar blocks-input">
            <ui:Label name="round" class="stat" text="라운드 1" />
            <ui:Label name="spins" class="stat" text="남은 회전" />
            <ui:Label name="due" class="stat" text="납부금" />
            <ui:Label name="money" class="stat stat--money" text="보유" />
            <ui:VisualElement class="spacer" picking-mode="Ignore" />
            <ui:Label name="seed" class="seed" text="seed" />
            <ui:Button name="view-toggle" class="btn btn--small" text="시점 전환" />
        </ui:VisualElement>

        <ui:VisualElement class="result-panel" picking-mode="Ignore">
            <ui:Label name="result" class="result" picking-mode="Ignore" />
            <ui:Label name="history" class="history" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement class="control-panel blocks-input">
            <ui:VisualElement class="info">
                <ui:VisualElement class="row">
                    <ui:Label class="field-label" text="칩" />
                    <ui:Label name="chip-value" class="chip-value" text="0" />
                    <ui:Label name="hover-target" class="hover-target" />
                    <ui:Label name="skull-notice" class="skull-notice" text="해골: 모든 베팅 낙첨 + 보유 금액 절반" />
                </ui:VisualElement>
                <ui:VisualElement class="row">
                    <ui:Label class="field-label" text="베팅" />
                    <ui:Label name="bet-summary" class="field-value" text="없음" />
                    <ui:Label name="bet-list" class="bet-list" />
                </ui:VisualElement>
                <ui:VisualElement class="row">
                    <ui:Label name="payout-preview" class="preview" />
                    <ui:Label name="bet-error" class="error" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="button-row">
                <ui:Button name="bet-undo" class="btn btn--wide" text="마지막 칩 취소" />
                <ui:Button name="bet-clear" class="btn btn--wide" text="전체 취소" />
                <ui:Button name="shop" class="btn btn--wide btn--shop" text="상점" />
                <ui:Button name="spin" class="btn btn--primary" text="회전" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 라운드 통과 보상. 카드는 DrinkSelectionView가 후보 수만큼 만든다. -->
        <ui:VisualElement name="drink-panel" class="modal drink-modal blocks-input">
            <ui:VisualElement class="drink-box">
                <ui:Label name="drink-header" class="drink-header" />
                <ui:Label class="drink-title" text="음료 하나를 선택하세요" />
                <ui:VisualElement name="drink-cards" class="drink-cards" />
                <ui:Label name="drink-hint" class="drink-hint" text="카드를 눌러 고른 뒤 확정하세요. 효과는 이번 게임 끝까지 이어집니다. 지급 음료는 곱해서, 확률 음료는 더해서 쌓이고, 해골 확률(1/38)은 바뀌지 않습니다." />
                <ui:Button name="drink-confirm" class="btn drink-confirm" text="선택 확정" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 상점. 상품 카드·보유 아이템은 ShopView가 그린다. -->
        <ui:VisualElement name="shop-panel" class="modal shop-modal blocks-input">
            <ui:VisualElement class="shop-box">
                <ui:VisualElement class="shop-header">
                    <ui:Label class="shop-title" text="상점" />
                    <ui:Label name="shop-money" class="shop-money" />
                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                    <ui:Button name="shop-close" class="btn shop-close" text="✕" />
                </ui:VisualElement>
                <ui:VisualElement class="shop-tabs">
                    <ui:Button name="shop-tab-goods" class="shop-tab" text="상품" />
                    <ui:Button name="shop-tab-items" class="shop-tab" text="보유 아이템" />
                    <ui:Label name="shop-notice" class="shop-notice" />
                </ui:VisualElement>
                <ui:ScrollView name="shop-scroll" class="shop-scroll" mode="Vertical" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="gameover-panel" class="modal blocks-input">
            <ui:VisualElement class="modal__box">
                <ui:Label name="gameover-text" class="modal__text" />
                <ui:Button name="restart" class="btn btn--primary btn--modal" text="다시 시작" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
