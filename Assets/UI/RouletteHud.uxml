<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="RouletteHud.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <ui:VisualElement class="topbar blocks-input">
            <ui:Label name="round" class="stat" text="라운드 1" />
            <ui:Label name="spins" class="stat" text="남은 회전" />
            <ui:Label name="due" class="stat" text="납부금" />
            <ui:Label name="money" class="stat stat--money" text="보유" />
            <ui:VisualElement class="spacer" picking-mode="Ignore" />
            <ui:Label name="seed" class="seed" text="seed" />
            <ui:Button name="view-toggle" class="btn btn--small" text="시점 전환" />
        </ui:VisualElement>

        <ui:VisualElement class="result-panel" picking-mode="Ignore">
            <ui:Label name="result" class="result" picking-mode="Ignore" />
            <ui:Label name="history" class="history" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement class="control-panel blocks-input">
            <ui:VisualElement class="info">
                <ui:VisualElement class="row">
                    <ui:Label class="field-label" text="칩" />
                    <ui:Label name="chip-value" class="chip-value" text="0" />
                    <ui:Label name="hover-target" class="hover-target" />
                    <ui:Label name="skull-notice" class="skull-notice" text="해골: 이번 회전의 모든 베팅 낙첨" />
                </ui:VisualElement>
                <ui:VisualElement class="row">
                    <ui:Label class="field-label" text="베팅" />
                    <ui:Label name="bet-summary" class="field-value" text="없음" />
                    <ui:Label name="bet-list" class="bet-list" />
                </ui:VisualElement>
                <ui:VisualElement class="row">
                    <ui:Label name="payout-preview" class="preview" />
                    <ui:Label name="bet-error" class="error" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="button-row">
                <ui:Button name="bet-undo" class="btn btn--wide" text="마지막 칩 취소" />
                <ui:Button name="bet-clear" class="btn btn--wide" text="전체 취소" />
                <ui:Button name="spin" class="btn btn--primary" text="회전" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="payment-panel" class="modal blocks-input">
            <ui:VisualElement class="modal__box">
                <ui:Label name="payment-text" class="modal__text" />
                <ui:Button name="pay" class="btn btn--primary btn--modal" text="납부" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="gameover-panel" class="modal blocks-input">
            <ui:VisualElement class="modal__box">
                <ui:Label name="gameover-text" class="modal__text" />
                <ui:Button name="restart" class="btn btn--primary btn--modal" text="다시 시작" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
